# GitInfo.cmake : write the source tree's git state into a header.
#
# Run in script mode (cmake -P) by the `firedog_gitinfo` custom target on EVERY
# build, not once at configure: a configure-time answer goes stale the first
# time somebody commits and rebuilds without reconfiguring, and an exe that
# names the wrong commit is worse than one that names none.
#
# The header is rewritten only when its content changes (configure_file), so an
# unchanged tree recompiles nothing — only core/BuildInfo.cpp includes it.
#
# Inputs: -DSRC=<source dir> -DOUT=<header path> [-DGIT_EXECUTABLE=<git.exe>]

set(describe "unknown")
set(commit   "unknown")
set(branch   "unknown")
set(date     "")

function(_fd_git out)
    execute_process(COMMAND "${GIT_EXECUTABLE}" ${ARGN}
                    WORKING_DIRECTORY "${SRC}"
                    OUTPUT_VARIABLE _o OUTPUT_STRIP_TRAILING_WHITESPACE
                    RESULT_VARIABLE _rc ERROR_QUIET)
    if(_rc EQUAL 0 AND NOT _o STREQUAL "")
        set(${out} "${_o}" PARENT_SCOPE)
    endif()
endfunction()

if(GIT_EXECUTABLE AND EXISTS "${GIT_EXECUTABLE}")
    _fd_git(describe describe --tags --always --dirty)
    _fd_git(commit   rev-parse --short=10 HEAD)
    _fd_git(branch   rev-parse --abbrev-ref HEAD)
    _fd_git(date     log -1 --format=%cI)
endif()

file(WRITE "${OUT}.tmp"
"// Generated by cmake/GitInfo.cmake on every build - do not edit.
#pragma once
#define FD_GIT_DESCRIBE \"${describe}\"
#define FD_GIT_COMMIT   \"${commit}\"
#define FD_GIT_BRANCH   \"${branch}\"
#define FD_GIT_DATE     \"${date}\"
")
configure_file("${OUT}.tmp" "${OUT}" COPYONLY)
file(REMOVE "${OUT}.tmp")
